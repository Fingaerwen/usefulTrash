# Copy this file to .env (which git ignores) and fill in the values locally.
# Never paste these into chat, docs or commits. .env is never uploaded anywhere.
#
# All values below are PUBLIC-by-design identifiers (plan K2a): they ship inside the app.
# spikes/phase0/makePublicConfig.py copies exactly these into the app before a build.
# Find them in Supabase: Project Settings -> API Keys (publishable key) and Project Settings -> Data API (URL).
# NEVER put the "secret" key (sb_secret_...) in this file or anywhere else.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Google Cloud -> Google Auth Platform -> Clients -> the "Web application" client's Client ID
# (ends in .apps.googleusercontent.com). NEVER its client secret (GOCSPX-...): it isn't needed anywhere.
GOOGLE_WEB_CLIENT_ID=
