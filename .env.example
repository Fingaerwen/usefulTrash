# Copy this file to .env (which git ignores) and fill in the values locally.
# Never paste these into chat, docs or commits. .env is never uploaded anywhere.
#
# Both values below are PUBLIC-by-design identifiers (plan K2a): they ship inside the app.
# Find them in Supabase: Project Settings -> API Keys (publishable key) and Project Settings -> Data API (URL).
# NEVER put the "secret" key (sb_secret_...) in this file or anywhere else.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
