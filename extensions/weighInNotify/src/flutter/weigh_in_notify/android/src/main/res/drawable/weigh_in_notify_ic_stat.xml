    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M5,3h14a2,2 0,0 1,2 2v14a2,2 0,0 1,-2 2H5a2,2 0,0 1,-2 -2V5a2,2 0,0 1,2 -2z M8,6.5h8a1,1 0,0 1,1 1v2a1,1 0,0 1,-1 1h-8a1,1 0,0 1,-1 -1v-2a1,1 0,0 1,1 -1z" />
</vector>
