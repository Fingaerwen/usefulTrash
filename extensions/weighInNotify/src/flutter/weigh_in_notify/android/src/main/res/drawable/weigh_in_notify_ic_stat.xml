<?xml version="1.0" encoding="utf-8"?>
<!-- Status-bar icon for the weigh-in reminder: a bathroom scale with a display window (review F19).
     Android draws small notification icons from their shape only (it ignores colours), so this is a
     single white shape; the window is a hole cut out via evenOdd.
     The file name is snake_case because Android only allows lowercase letters, digits and _ in resource names;
     the weigh_in_notify_ prefix keeps it from clashing with the app's own resources. -->
