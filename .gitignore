# Python virtual environment (one shared venv for the whole repo)
.venv/
__pycache__/
*.pyc

# Secrets: never committed, never uploaded anywhere
.env
.env.*
# empty template, safe to commit
!.env.example
*.jks
*.keystore
*.p12
*.pem
signing/
# Android signing settings file (holds keystore passwords)
key.properties
# Public identifiers copied from .env into the app at build time (spikes/phase0/makePublicConfig.py).
# Public by design (plan K2a), but generated from .env, so it stays out of git like .env itself.
spikes/phase0/src/publicConfig.json

# Local data and build output
*.db
.flet/
build/
# Built apps (releases go to GitHub Releases, never into git; a 140 MB APK would also be rejected)
*.apk
*.aab
.pytest_cache/
.ruff_cache/

# Python packaging leftovers
*.egg-info/
